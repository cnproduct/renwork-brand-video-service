{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RenWorkVideoProductionManifest",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "scenes",
    "artifacts",
    "stages",
    "acceptance_gates",
    "history"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "project": {
      "type": "object",
      "required": [
        "project_id",
        "root",
        "brand_profile_id",
        "aspect_ratio",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "project_id": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "minLength": 1 },
        "brand_profile_id": { "type": "string", "minLength": 1 },
        "brief_source": { "type": ["string", "null"] },
        "channel": { "type": ["string", "null"] },
        "aspect_ratio": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
        "target_duration_seconds": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/scene" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/definitions/artifact" }
    },
    "stages": {
      "type": "object",
      "required": [
        "planning",
        "scene_generation",
        "composition",
        "cover",
        "channel_copy",
        "technical_validation"
      ],
      "additionalProperties": { "type": "string" }
    },
    "acceptance_gates": {
      "type": "object",
      "required": [
        "technical_playback",
        "scene_content_match",
        "picture_subtitle_audio_sync",
        "no_duplicate_footage",
        "brand_consistency",
        "cover_applied",
        "human_review"
      ],
      "additionalProperties": { "$ref": "#/definitions/gate" }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "action", "details"],
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "action": { "type": "string", "minLength": 1 },
          "details": { "type": "object" }
        }
      }
    }
  },
  "definitions": {
    "scene": {
      "type": "object",
      "required": [
        "scene_id",
        "order",
        "slug",
        "title",
        "expected_path",
        "status",
        "selected_artifact",
        "attempts",
        "review"
      ],
      "properties": {
        "scene_id": { "type": "string", "pattern": "^scene[1-9][0-9]*$" },
        "order": { "type": "integer", "minimum": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "expected_path": { "type": "string", "pattern": "^scene[1-9][0-9]*[_-].*\\.mp4$" },
        "status": {
          "enum": [
            "planned",
            "prompted",
            "generating",
            "generated",
            "technically_verified",
            "needs_revision",
            "accepted",
            "blocked"
          ]
        },
        "selected_artifact": { "type": ["string", "null"] },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["timestamp", "provider", "status", "artifact", "note"],
            "properties": {
              "timestamp": { "type": "string", "format": "date-time" },
              "provider": { "type": ["string", "null"] },
              "status": {
                "enum": ["submitted", "succeeded", "failed", "rejected", "blocked"]
              },
              "artifact": { "type": ["string", "null"] },
              "note": { "type": ["string", "null"] }
            }
          }
        },
        "review": {
          "type": "object",
          "required": ["technical", "content", "notes"],
          "properties": {
            "technical": { "type": "string" },
            "content": { "type": "string" },
            "notes": { "type": "array" }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["path", "role", "bytes", "modified_at", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "role": {
          "enum": [
            "scene_video",
            "composite_video",
            "final_video",
            "cover",
            "channel_copy",
            "audio",
            "production_script",
            "other"
          ]
        },
        "bytes": { "type": "integer", "minimum": 0 },
        "modified_at": { "type": "string", "format": "date-time" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "media": { "type": ["object", "null"] },
        "review": { "type": "object" }
      }
    },
    "gate": {
      "type": "object",
      "required": ["status", "evidence", "reviewer", "note", "updated_at"],
      "properties": {
        "status": { "enum": ["pending", "pass", "fail", "waived"] },
        "evidence": { "type": ["string", "null"] },
        "reviewer": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] },
        "updated_at": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
